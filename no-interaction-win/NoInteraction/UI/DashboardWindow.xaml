<Window x:Class="NoInteraction.UI.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NoInteraction" Width="740" Height="560" MinWidth="600" MinHeight="460"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="#1e1e2e" Foreground="#cdd6f4"
        FontFamily="Segoe UI, Arial, sans-serif">

    <Window.Resources>
        <!-- Modern ScrollViewer style -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="8"/>
        </Style>

        <!-- Custom styling for TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#252538"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderBrush" Value="#45475a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="CaretBrush" Value="#cba6f7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#cba6f7"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#cba6f7"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom styling for Button -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#252538"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Background" Value="#cba6f7"/>
                                <Setter Property="Foreground" Value="#1e1e2e"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter Property="Background" Value="#b4befe"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom styling for CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Custom TabControl Style -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Custom TabItem Style -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#a6adc8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Foreground" Value="#cba6f7"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter Property="Foreground" Value="#cba6f7"/>
                                <Setter Property="Background" Value="#252538"/>
                                <Setter TargetName="border" Property="CornerRadius" Value="6,6,0,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom ListView Style -->
        <Style TargetType="ListView">
            <Setter Property="Background" Value="#252538"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderBrush" Value="#45475a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListView">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer Focusable="false" Padding="{TemplateBinding Padding}">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom ListViewItem Style -->
        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <GridViewRowPresenter Content="{TemplateBinding Content}" Columns="{TemplateBinding GridView.ColumnCollection}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Background" Value="#313244"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter Property="Background" Value="#cba6f7"/>
                                <Setter Property="Foreground" Value="#1e1e2e"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="18,14" Background="#1e1e2e" BorderBrush="#45475a" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="NoInteraction" FontSize="18" FontWeight="Bold" Foreground="#cba6f7" VerticalAlignment="Center"/>
                        <Border Background="#45475a" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="VersionBadge" Text="v0.0" FontSize="9" FontWeight="Bold" Foreground="#bac2de"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Text="Active &amp; Monitoring Prompts" FontSize="11" Foreground="#a6adc8" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Border Background="#252538" CornerRadius="12" Padding="10,5" BorderBrush="#a6e3a1" BorderThickness="1">
                        <TextBlock x:Name="ApprovedBadge" Text="0 Approved" FontSize="11" FontWeight="Bold" Foreground="#a6e3a1"/>
                    </Border>
                </StackPanel>

                <Button x:Name="SoundButton" Grid.Column="3" Content="🔊" Width="32" Height="30" Padding="0" Margin="0,0,12,0" Click="SoundButton_Click" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

                <CheckBox x:Name="EnabledToggle" Grid.Column="4" Content="Active Monitoring" VerticalAlignment="Center" Click="EnabledToggle_Click" FontSize="12" FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <!-- Body Tabs -->
        <TabControl Grid.Row="1" Margin="12">
            <!-- Tab 1: Activity Log -->
            <TabItem Header="Activity Log">
                <Grid Margin="6,12,6,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="LogSearchBox" Grid.Column="0" TextChanged="LogSearchBox_TextChanged"
                                 ToolTip="Filter activity log..." Padding="8,6" Background="#252538" BorderBrush="#45475a"/>
                        <Button Grid.Column="1" Content="Clear Logs" Margin="10,0,0,0" Click="ClearLog_Click"/>
                    </Grid>

                    <ListView x:Name="LogListView" Grid.Row="1" BorderBrush="#45475a" Background="#252538">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Target Element Text" Width="220" DisplayMemberBinding="{Binding TargetText}"/>
                                <GridViewColumn Header="Application" Width="140" DisplayMemberBinding="{Binding AppName}"/>
                                <GridViewColumn Header="Method" Width="120" DisplayMemberBinding="{Binding DetectionMethod}"/>
                                <GridViewColumn Header="Time" Width="100" DisplayMemberBinding="{Binding FormattedTime}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>

            <!-- Tab 2: Approval Rules -->
            <TabItem Header="Approval Rules">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel Margin="6,10,6,6">
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Custom Verification Bypass" FontSize="14" FontWeight="Bold" Foreground="#cba6f7"/>
                                <TextBlock Text="Add label keywords to auto-accept confirmation dialogs and alerts." TextWrapping="Wrap" Foreground="#a6adc8" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Reset Defaults" Click="ResetDefaults_Click" Padding="10,5" FontSize="11"/>
                        </Grid>

                        <Border Background="#252538" CornerRadius="8" Padding="14" BorderBrush="#45475a" BorderThickness="1" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Auto-Click Buttons" FontSize="13" FontWeight="Bold" Foreground="#cba6f7" Margin="0,0,0,2"/>
                                <TextBlock Text="Automatically clicks buttons with these labels when confirmation is prompted." FontSize="11" Foreground="#a6adc8" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="NewButtonKeywordBox" Grid.Column="0" Padding="8,5"/>
                                    <Button Grid.Column="1" Content="Add Button" Margin="10,0,0,0" Click="AddButtonRule_Click"/>
                                </Grid>
                                <ItemsControl x:Name="ButtonRulesList" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#252538" CornerRadius="8" Padding="14" BorderBrush="#45475a" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Auto-Tick Checkboxes" FontSize="13" FontWeight="Bold" Foreground="#cba6f7" Margin="0,0,0,2"/>
                                <TextBlock Text="Ticks checkboxes with these labels before confirming the action." FontSize="11" Foreground="#a6adc8" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="NewCheckboxKeywordBox" Grid.Column="0" Padding="8,5"/>
                                    <Button Grid.Column="1" Content="Add Checkbox" Margin="10,0,0,0" Click="AddCheckboxRule_Click"/>
                                </Grid>
                                <ItemsControl x:Name="CheckboxRulesList" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 3: Prompt Queue -->
            <TabItem Header="Prompt Queue">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                    <StackPanel Margin="6,10,6,6">
                        <!-- Dispatch Card -->
                        <Border Background="#252538" CornerRadius="8" Padding="14" BorderBrush="#45475a" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Prompt Queue Dispatch" FontSize="13" FontWeight="Bold" Foreground="#cba6f7"/>
                                        <TextBlock Text="Sequentially paste prompts automatically when the agent window is free." FontSize="11" Foreground="#a6adc8"/>
                                    </StackPanel>
                                    <CheckBox x:Name="PromptQueueToggle" Grid.Column="1" Content="Enable Queue" VerticalAlignment="Center" Click="PromptQueueToggle_Click"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock x:Name="QueueStatusText" Text="Status: Active — Ready" FontSize="11" Foreground="#a6e3a1" VerticalAlignment="Center"/>
                                    <Button x:Name="RestartQueueButton" Content="Restart Queue" Margin="12,0,0,0" Click="RestartQueue_Click" Padding="8,3" FontSize="10.5"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Loop Mode Card -->
                        <Border Background="#252538" CornerRadius="8" Padding="14" BorderBrush="#45475a" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Loop Test Mode" FontSize="13" FontWeight="Bold" Foreground="#cba6f7"/>
                                        <TextBlock Text="Repetitive stress-testing via sequential system auditing." FontSize="11" Foreground="#a6adc8"/>
                                    </StackPanel>
                                    <CheckBox x:Name="LoopModeToggle" Grid.Column="1" Content="Enable Loop Mode" VerticalAlignment="Center" Click="LoopModeToggle_Click"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="Limit: " FontSize="11" Foreground="#a6adc8" VerticalAlignment="Center"/>
                                    <ComboBox x:Name="LoopLimitCombo" Width="110" SelectionChanged="LoopLimitCombo_SelectionChanged" Background="#1e1e2e" Foreground="#cdd6f4">
                                        <ComboBoxItem Content="Infinite" IsSelected="True"/>
                                        <ComboBoxItem Content="10 Iterations"/>
                                    </ComboBox>
                                    <TextBlock x:Name="LoopCounterText" Text="Dispatched: 0 / ∞" FontSize="11" Foreground="#cdd6f4" Margin="16,0,0,0" VerticalAlignment="Center"/>
                                    <Button x:Name="ResetLoopButton" Content="Reset Counter" Margin="12,0,0,0" Click="ResetLoop_Click" Padding="8,3" FontSize="10.5"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Add Custom Prompt Card -->
                        <Border Background="#252538" CornerRadius="8" Padding="14" BorderBrush="#45475a" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Add New Custom Prompt" FontSize="13" FontWeight="Bold" Foreground="#cba6f7" Margin="0,0,0,6"/>
                                <TextBox x:Name="NewPromptTextBox" Height="65" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"/>
                                <Button Content="Queue Prompt" HorizontalAlignment="Right" Click="AddPrompt_Click" Padding="12,5"/>
                            </StackPanel>
                        </Border>

                        <!-- Configured Queue List Card -->
                        <Border Background="#252538" CornerRadius="8" Padding="14" BorderBrush="#45475a" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Configured Queue" FontSize="13" FontWeight="Bold" Foreground="#cba6f7" Grid.Column="0"/>
                                    <Button Content="Clear All" Grid.Column="1" Click="ClearQueue_Click" Padding="8,3" FontSize="10.5" Foreground="#f38ba8"/>
                                </Grid>
                                <ItemsControl x:Name="PromptQueueItemsControl"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Tab 4: Terminals -->
            <TabItem Header="Terminals">
                <Grid Margin="6,12,6,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#252538" CornerRadius="8" Padding="14" BorderBrush="#45475a" BorderThickness="1" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Terminal.app &amp; PowerShell Sessions" FontSize="14" FontWeight="Bold" Foreground="#cba6f7"/>
                                <TextBlock Text="Attach a session to auto-press Return when it shows a y/n or continue prompt." FontSize="11" Foreground="#a6adc8" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="TerminalMonitoringToggle" Grid.Column="1" Content="Enable Monitoring" VerticalAlignment="Center" Click="TerminalMonitoringToggle_Click"/>
                        </Grid>
                    </Border>

                    <ListView x:Name="TerminalSessionsListView" Grid.Row="1" BorderBrush="#45475a" Background="#252538">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Session Title" Width="260" DisplayMemberBinding="{Binding Title}"/>
                                <GridViewColumn Header="Process" Width="140" DisplayMemberBinding="{Binding ProcessName}"/>
                                <GridViewColumn Header="PID" Width="80" DisplayMemberBinding="{Binding ProcessId}"/>
                                <GridViewColumn Header="Status" Width="100" DisplayMemberBinding="{Binding IsAttached}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="14,10" Background="#1e1e2e" BorderBrush="#45475a" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Fill="#a6e3a1" Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="EngineStatusFooterText" Text="Engine Online" FontSize="11" FontWeight="SemiBold" Foreground="#a6adc8" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Hide to Tray" Click="HideToTray_Click" Padding="12,4" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="NoInteraction.UI.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NoInteraction" Width="560" Height="480" MinWidth="480" MinHeight="380"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="16,12" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="NoInteraction" FontSize="16" FontWeight="Bold"/>
                        <TextBlock Text="v1.0 (Windows)" FontSize="10" FontWeight="Bold" Foreground="Gray" Margin="6,3,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Text="Active &amp; Monitoring" FontSize="11" Foreground="Gray"/>
                </StackPanel>

                <Border Grid.Column="2" Background="#DCF5DC" CornerRadius="10" Padding="9,4" Margin="0,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ApprovedBadge" Text="0 Approved" FontSize="11" FontWeight="SemiBold" Foreground="#2E7D32"/>
                </Border>

                <Button x:Name="SoundButton" Grid.Column="3" Content="🔊" Width="30" Height="26" Margin="0,0,8,0" Click="SoundButton_Click"/>

                <CheckBox x:Name="EnabledToggle" Grid.Column="4" Content="Enabled" VerticalAlignment="Center" Click="EnabledToggle_Click"/>
            </Grid>
        </Border>

        <!-- Body -->
        <TabControl Grid.Row="1" Margin="8">
            <TabItem Header="Activity Log">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="LogSearchBox" Grid.Column="0" TextChanged="LogSearchBox_TextChanged"
                                 ToolTip="Filter activity log..." Padding="4"/>
                        <Button Grid.Column="1" Content="Clear Log" Margin="6,0,0,0" Click="ClearLog_Click"/>
                    </Grid>

                    <ListView x:Name="LogListView" Grid.Row="1">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Target" Width="180" DisplayMemberBinding="{Binding TargetText}"/>
                                <GridViewColumn Header="App" Width="130" DisplayMemberBinding="{Binding AppName}"/>
                                <GridViewColumn Header="Method" Width="110" DisplayMemberBinding="{Binding DetectionMethod}"/>
                                <GridViewColumn Header="Time" Width="90" DisplayMemberBinding="{Binding FormattedTime}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>

            <TabItem Header="Approval Rules">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="6">
                    <StackPanel Margin="6">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Configure keywords for auto-clicking buttons and auto-ticking checkboxes." TextWrapping="Wrap" Foreground="Gray" FontSize="11"/>
                            <Button Grid.Column="1" Content="Reset Defaults" Click="ResetDefaults_Click"/>
                        </Grid>

                        <TextBlock Text="Auto-Click Buttons" FontWeight="Bold" Margin="0,4,0,2"/>
                        <TextBlock Text="Buttons with these titles will be auto-clicked when prompted." FontSize="11" Foreground="Gray" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NewButtonKeywordBox" Padding="4"/>
                            <Button Grid.Column="1" Content="Add" Margin="6,0,0,0" Click="AddButtonRule_Click"/>
                        </Grid>
                        <ItemsControl x:Name="ButtonRulesList"/>

                        <Separator Margin="0,14,0,14"/>

                        <TextBlock Text="Auto-Tick Checkboxes" FontWeight="Bold" Margin="0,4,0,2"/>
                        <TextBlock Text="Checkboxes with these labels will be auto-ticked before approving." FontSize="11" Foreground="Gray" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NewCheckboxKeywordBox" Padding="4"/>
                            <Button Grid.Column="1" Content="Add" Margin="6,0,0,0" Click="AddCheckboxRule_Click"/>
                        </Grid>
                        <ItemsControl x:Name="CheckboxRulesList"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="2" Padding="10,6" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="UI Automation Ready" FontSize="10" Foreground="Gray" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Hide to Tray" Click="HideToTray_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>

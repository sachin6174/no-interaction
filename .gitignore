# ==============================================================================
# Git Ignore Configuration — NoInteraction Multi-Platform Workspace
# Supports: macOS (Swift/SPM), Linux (Python), Windows (C#/.NET/WPF)
# ==============================================================================

# ── 1. Operating System Files ──────────────────────────────────────────────────
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory
*~
.fuse_hidden*
.trash/

# ── 2. IDEs & Code Editors ────────────────────────────────────────────────────
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Visual Studio / MonoDevelop
.vs/
*.suo
*.user
*.userosv
*.sln.docstates
*.userprefs

# JetBrains (PyCharm, Rider, CLion, WebStorm)
.idea/
*.iws
*.iml
*.ipr

# Vim & Emacs
*.swp
*.swo
.#*
#*#

# ── 3. macOS & Swift / Xcode Build Artifacts ──────────────────────────────────
.build/
.build_clean/
build/
build_dist/
DerivedData/
*.app/
*.pkg
*.dmg
*.ipa
*.xcarchive
*.dSYM/
*.dSYM.zip
*.o
*.a
*.dylib
*.so
*.framework/

# Xcode & SwiftPM User Data
*.xcodeproj/xcuserdata/
*.xcodeproj/project.xcworkspace/xcuserdata/
*.xcworkspace/xcuserdata/
*.xcodeproj/xcshareddata/xcodeprojUsers/
.swiftpm/xcode/
.swiftpm/configuration/

# ── 4. Linux & Python Environments ───────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
.venv*/
.venv_ssh/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
dist/
sdist/
eggs/
.eggs/

# ── 5. Windows & C# / .NET Build Artifacts ────────────────────────────────────
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
Output/
installer_output/
*.nupkg
*.snupkg
*.pubxml.user

# ── 6. Security, Secrets & Private Configuration ──────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
*.mobileprovision
*.provisionprofile
*.keychain
*.keychain-db
credentials.json
secrets.json
sachin-person.config

# ── 7. Logs, Caches & Temporary Files ──────────────────────────────────────────
*.log
*.tmp
*.temp
*.bak
*.crash
.cache/
.clang-module-cache/
